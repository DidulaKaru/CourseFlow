# CourseFlow Backend Configuration

# Local PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/courseflow

# Neon Serverless PostgreSQL (Free Tier)
# Use the pooled connection string (-pooler endpoint) with sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-cool-fog-12345678-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins (Comma-separated or JSON list)
# Cloudflare Pages domains (*.pages.dev) are automatically allowed by regex, but custom domains can be added here
CORS_ORIGINS=https://courseflow.pages.dev,http://localhost:5173,http://localhost:3000

# Security & Environment
ENVIRONMENT=production
SECRET_KEY=generate-a-secure-random-secret-key-for-production
