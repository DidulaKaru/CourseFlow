# CourseFlow Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local, containerized, or cloud deployments

# ==========================================
# 1. Database Configuration (Neon Free Tier or Local PostgreSQL)
# ==========================================
# Local Docker or Native Postgres:
# DATABASE_URL=postgresql+psycopg://postgres:CourseFlow5678db@localhost:5433/courseflow
# Neon Serverless PostgreSQL (Recommended for Free Cloud Hosting):
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-cool-fog-12345678-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# 2. Backend API Configuration (FastAPI on Vercel)
# ==========================================
PROJECT_NAME=CourseFlow API
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=production
SECRET_KEY=generate-a-secure-random-secret-key-for-production
# CORS Allowed Origins:
# Note: Cloudflare Pages *.pages.dev domains are automatically allowed by regex,
# but custom production domains should be added here:
CORS_ORIGINS=https://courseflow.pages.dev,http://localhost:5173,http://localhost:3000

# Academic Constants
MIN_CREDITS_PER_SEMESTER=18
MAX_CREDITS_PER_SEMESTER=24
TOTAL_CREDITS_REQUIRED=150
DEFAULT_SEMESTERS_COUNT=8

# ==========================================
# 3. Frontend Configuration (Cloudflare Pages)
# ==========================================
# In Cloudflare Pages, set VITE_API_BASE_URL to your deployed Vercel backend URL:
VITE_API_BASE_URL=https://your-courseflow-backend.vercel.app
