# CourseFlow Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local, containerized, or cloud deployments

# ==========================================
# 0. Local Docker Compose Stack (`docker compose up`)
# ==========================================
# All values below are optional: docker-compose.yml falls back to these defaults,
# so `docker compose up` works with no .env file at all.
# Inside Compose, the backend always reaches Postgres at db:5432 and the Vite
# dev server proxies /api to http://backend:8000 (VITE_PROXY_TARGET).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CourseFlow5678db
POSTGRES_DB=courseflow
# Host ports published by Compose (change if already in use on your machine)
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Local SLM runtime (Ollama). The first `docker compose up` downloads the model (~4.7 GB)
# into the `ollama_models` volume; later runs reuse it. Backend does not wait for it.
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Optional space-separated list to pull several models, e.g. "qwen2.5:7b-instruct phi3.5:3.8b-instruct"
# OLLAMA_MODELS_TO_PULL=

# ==========================================
# 1. Database Configuration (Neon Free Tier or Local PostgreSQL)
# ==========================================
# Local Docker or Native Postgres (from the host machine):
# DATABASE_URL=postgresql+psycopg://postgres:CourseFlow5678db@localhost:5432/courseflow
# Neon Serverless PostgreSQL (Recommended for Free Cloud Hosting):
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-cool-fog-12345678-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# 2. Backend API Configuration (FastAPI on Vercel)
# ==========================================
PROJECT_NAME=CourseFlow API
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=production
SECRET_KEY=generate-a-secure-random-secret-key-for-production
# CORS Allowed Origins:
# Note: Cloudflare Pages *.pages.dev domains are automatically allowed by regex,
# but custom production domains should be added here:
CORS_ORIGINS=https://courseflow.pages.dev,http://localhost:5173,http://localhost:3000

# Academic Constants
MIN_CREDITS_PER_SEMESTER=18
MAX_CREDITS_PER_SEMESTER=24
TOTAL_CREDITS_REQUIRED=150
DEFAULT_SEMESTERS_COUNT=8

# ==========================================
# 3. Frontend Configuration (Cloudflare Pages)
# ==========================================
# In Cloudflare Pages, set VITE_API_BASE_URL to your deployed Vercel backend URL:
VITE_API_BASE_URL=https://your-courseflow-backend.vercel.app
