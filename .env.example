# CourseFlow Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local or containerized execution

# ==========================================
# Database Configuration (PostgreSQL + pgvector)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CourseFlow5678db
POSTGRES_DB=courseflow
POSTGRES_PORT=5433

# Database Connection URL
# For native Windows local development (dedicated instance on port 5433):
DATABASE_URL=postgresql+psycopg://postgres:CourseFlow5678db@localhost:5433/courseflow
# For Docker Compose execution:
# DATABASE_URL=postgresql+psycopg://postgres:CourseFlow5678db@db:5432/courseflow

# ==========================================
# Backend API Configuration (FastAPI)
# ==========================================
PROJECT_NAME=CourseFlow API
VERSION=1.0.0
API_V1_STR=/api/v1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Academic Constants
MIN_CREDITS_PER_SEMESTER=18
MAX_CREDITS_PER_SEMESTER=24
TOTAL_CREDITS_REQUIRED=150
DEFAULT_SEMESTERS_COUNT=8

# ==========================================
# Frontend Configuration (Vite + React)
# ==========================================
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
