{
  "name": "courseflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run backend\" \"npm run dev\"",
    "dev": "npm --workspace=frontend run dev",
    "backend": "python -m uvicorn app.main:app --reload --port 8000 --app-dir backend",
    "build": "npm --workspace=frontend run build",
    "lint": "npm --workspace=frontend run lint",
    "test": "npm --workspace=frontend test",
    "typecheck": "npm --workspace=frontend run typecheck",
    "preview": "npm --workspace=frontend run preview",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "npm --workspace=frontend run lint"
    ],
    "backend/**/*.py": [
      "python -m ruff check"
    ]
  }
}
